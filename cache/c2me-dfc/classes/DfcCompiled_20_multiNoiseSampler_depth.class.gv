	fs [shape=box, label=<<TABLE><TR><TD>idx</TD><TD>derivatives</TD><TD>locations</TD><TD>values</TD></TR><TR><TD>0</TD><TD>0.0</TD><TD>-1.0</TD><TD>-0.05</TD></TR><TR><TD>1</TD><TD>0.0</TD><TD>-0.4</TD><TD>children.id=fp</TD></TR><TR><TD>2</TD><TD>0.0</TD><TD>0.0</TD><TD>0.17</TD></TR></TABLE>>, tooltip="children[1].id=fp\n"]
	fp -> fs [label="children[1]"]
	ft [shape=hexagon, label="id=ft\nSpline", tooltip="locationFunction.id=bf\nSplineTable.id=fu\n"]
	bf -> ft [label="locationFunction"]
	fu -> ft [label="SplineTable"]
	fu [shape=box, label=<<TABLE><TR><TD>idx</TD><TD>derivatives</TD><TD>locations</TD><TD>values</TD></TR><TR><TD>0</TD><TD>0.015</TD><TD>-1.0</TD><TD>-0.02</TD></TR><TR><TD>1</TD><TD>0.0</TD><TD>-0.4</TD><TD>0.01</TD></TR><TR><TD>2</TD><TD>0.0</TD><TD>0.0</TD><TD>0.01</TD></TR><TR><TD>3</TD><TD>0.04</TD><TD>0.4</TD><TD>0.03</TD></TR><TR><TD>4</TD><TD>0.049</TD><TD>1.0</TD><TD>0.1</TD></TR></TABLE>>, tooltip=""]
}