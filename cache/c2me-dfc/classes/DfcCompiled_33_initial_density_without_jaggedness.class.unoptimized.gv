	el [shape=hexagon, label="id=el\nSpline", tooltip="locationFunction.id=cl\nSplineTable.id=em\n"]
	cl -> el [label="locationFunction"]
	em -> el [label="SplineTable"]
	em [shape=box, label=<<TABLE><TR><TD>idx</TD><TD>derivatives</TD><TD>locations</TD><TD>values</TD></TR><TR><TD>0</TD><TD>0.0</TD><TD>-0.5</TD><TD>4.25</TD></TR><TR><TD>1</TD><TD>0.0</TD><TD>0.0</TD><TD>2.5</TD></TR><TR><TD>2</TD><TD>0.0</TD><TD>0.5</TD><TD>3.0</TD></TR></TABLE>>, tooltip=""]
	en [shape=hexagon, label="id=en\nSpline", tooltip="locationFunction.id=cl\nSplineTable.id=eo\n"]
	cl -> en [label="locationFunction"]
	eo -> en [label="SplineTable"]
	eo [shape=box, label=<<TABLE><TR><TD>idx</TD><TD>derivatives</TD><TD>locations</TD><TD>values</TD></TR><TR><TD>0</TD><TD>0.0</TD><TD>-0.5</TD><TD>2.65</TD></TR><TR><TD>1</TD><TD>0.0</TD><TD>0.0</TD><TD>2.0</TD></TR><TR><TD>2</TD><TD>0.0</TD><TD>0.5</TD><TD>4.25</TD></TR></TABLE>>, tooltip=""]
}