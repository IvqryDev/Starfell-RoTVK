	// Percentage of total stamina making the player fatigued
	"fatiguedPercentage": 0,
	// Stamina points depleted per tick while sprinting.
	"depletionPerTickSprinting": 0.5,
	// Stamina points depleted per tick while swimming.
	"depletionPerTickSwimming": 0.5,
	// Stamina points depleted per tick while moving in water.
