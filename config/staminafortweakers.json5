	"exhaustionSounds": false,
	// Efficiency increases exhaustion
	"efficiencyExhausts": false,
	// % of max stamina recovered per tick.
	"recoveryPerTick": 0.75,
	// Bonus recovery multiplier for not moving.
	"recoveryRestBonusMultiplier": 2.0,
	// Do players recover stamina while walking?
	"recoverWhileWalking": true,
	// Do players recover stamina while sneaking?
	"recoverWhileSneaking": true,
	// Do players recover stamina when too hungry to sprint?
	"recoverWhenHungry": true,
	// Do players recover stamina when not on the ground?
	"recoverWhileAirborne": false,
	// Do players recover stamina when submerged?
	"recoverUnderwater": true,
	// Do players recover stamina when suffocating?
	"recoverWhileBreathless": false,
	// Delay in ticks before starting recovery from exhaustion
	"recoveryExhaustDelayTicks": 0,
	// Delay in ticks before starting recovery after depletion
	"recoveryDelayTicks": 19,
	// Delay in ticks before regaining shield use
	"shieldRecoveryDelayTicks": 0,
	// Do players fully recover stamina on respawn?
	"fullRecoveryOnRespawn": true,
	// Which formula to use for recovery
