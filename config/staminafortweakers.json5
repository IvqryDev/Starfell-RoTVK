	// Stamina points depleted per tick while climbing.
	"depletionPerTickClimbing": 0.0,
	// Stamina points depleted per jump
	"depletionPerJump": 2.0,
	// Stamina points depleted per attack
	"depletionPerAttack": 0.0,
	// Stamina points depleted per weapon swing
	"depletionPerWeaponSwing": 1.5,
	// Stamina points depleted per tick while mining
	"depletionPerMiningTick": 1.0,
	// Stamina points depleted per block broken
	"depletionPerBlockBroken": 1.5,
	// Stamina points depleted per tick while using a shield
	"depletionPerShieldTick": 0.0,
	// Stamina points depleted per successful shield block
	"depletionPerShieldBlock": 2.5,
	// Stamina points depleted per tick while using a glider
	"depletionPerGliderTick": 0.0,
	// Can jump while exhausted
	"canJumpWhileExhausted": false,
